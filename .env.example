# ==============================================================================
# [청년공간 상담실 예약 시스템 - 환경변수 설정 파일 (.env.local)]
# 
# 이 파일은 데이터베이스(Supabase) 연결 정보와 보안 암호화 키를 보관합니다.
# 절대 깃허브(GitHub) 등 공개된 장소에 공유하거나 커밋하지 마세요!
# ==============================================================================

# 1. Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. 개인정보(휴대폰 번호) 암호화용 대칭키 (AES-256)
# 정확히 32자리의 영문/숫자/특수문자 조합 비밀키를 입력하세요.
# 예: youth-counseling-secret-key-32ch! (32글자)
ENCRYPTION_SECRET=youth-counseling-secret-key-32ch!

# 3. 공간 관리자 마스터 비밀번호 (기본 관리자 로그인용)
# 관리자 페이지(/admin) 접속 시 입력할 초기 비밀번호입니다.
ADMIN_PASSWORD=admin1234
